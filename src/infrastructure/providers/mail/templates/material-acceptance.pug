extends layouts/base

block label
  | Comunicado

block title
  | Confirmação de leitura

block content
  if name
    p(style="margin:0 0 16px 0;") #{name},
  p(style="margin:0 0 16px 0;") Foi publicado um novo material que exige confirmação de leitura:
  p(style="margin:0 0 16px 0;")
    strong #{materialName}
  p(style="margin:0;") Por favor, acesse o material e confirme que leu e aceitou o conteúdo.

block cta
  if materialLink
    a(href=materialLink style="display:inline-block;padding:24px 48px;background-color:#E95814;color:#FFFFFF;text-decoration:none;border-radius:12px;font-family:Arial,Helvetica,sans-serif;font-size:18px;font-weight:700;letter-spacing:-0.02em;line-height:1;") Acessar material
