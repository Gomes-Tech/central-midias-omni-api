generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UF {
  AC
  AL
  AP
  AM
  BA
  CE
  DF
  ES
  GO
  MA
  MT
  MS
  MG
  PA
  PB
  PR
  PE
  PI
  RJ
  RN
  RS
  RO
  RR
  SC
  SP
  SE
  TO
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  password      String
  taxIdentifier String    @map("tax_identifier")
  phone         String?   @map("phone")
  socialReason  String?   @map("social_reason")
  avatarKey     String?   @map("avatar_key")
  birthDate     DateTime? @map("birth_date")
  admissionDate DateTime? @map("admission_date")
  city          String?   @map("city")
  uf            UF?       @map("uf")
  isFirstAccess Boolean   @default(true) @map("is_first_access")
  isActive      Boolean   @default(true) @map("is_active")
  isDeleted     Boolean   @default(false) @map("is_deleted")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  globalRoleId String? @map("global_role_id")
  globalRole   Role?   @relation(fields: [globalRoleId], references: [id])

  managedUsers        UserHierarchy[]          @relation("ManagerRelation")
  managerOf           UserHierarchy[]          @relation("SubordinateRelation")
  members             Member[]
  materialAcceptances MaterialAcceptance[]
  materialDownloads   MaterialDownload[]
  printExports        PrintExport[]
  tagSearches         TagSearch[]
  platformLogin       UserPlatformLogin?
  platformLoginEvents UserPlatformLoginEvent[]
  calendarEvents      CalendarEvent[]
  notifications       Notification[]

  @@index([email])
  @@map("users")
}

model UserPlatformLogin {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  lastLoginAt DateTime @default(now()) @map("last_login_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastLoginAt])
  @@map("user_platform_logins")
}

model UserPlatformLoginEvent {
  id      String   @id @default(uuid())
  userId  String   @map("user_id")
  loginAt DateTime @default(now()) @map("login_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([loginAt])
  @@map("user_platform_login_events")
}

model UserHierarchy {
  id String @id @default(uuid())

  managerId      String @map("manager_id")
  subordinateId  String @map("subordinate_id")
  organizationId String @map("organization_id")

  manager      User         @relation("ManagerRelation", fields: [managerId], references: [id])
  subordinate  User         @relation("SubordinateRelation", fields: [subordinateId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([subordinateId, organizationId])
  @@index([managerId, organizationId])
  @@map("user_hierarchies")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  email     String
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

// ============================================================
// RBAC (GLOBAL)
// ============================================================

model Role {
  id                  String    @id @default(uuid())
  name                String    @unique
  label               String
  isSystem            Boolean   @default(false) @map("is_system")
  canAccessBackoffice Boolean   @default(false) @map("can_access_backoffice")
  canHaveSubordinates Boolean   @default(false) @map("can_have_subordinates")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  permissions          RolePermission[]
  members              Member[]
  categoryRoleAccesses CategoryRoleAccess[]
  users                User[]

  @@map("roles")
}

model Module {
  id    String @id @default(uuid())
  name  String @unique // organizations, materials, categories
  label String

  permissions RolePermission[]

  @@map("modules")
}

enum Action {
  CREATE
  READ
  UPDATE
  DELETE
}

model RolePermission {
  id String @id @default(uuid())

  roleId   String @map("role_id")
  moduleId String @map("module_id")
  action   Action

  role   Role   @relation(fields: [roleId], references: [id])
  module Module @relation(fields: [moduleId], references: [id])

  @@unique([roleId, moduleId, action])
  @@index([moduleId])
  @@map("role_permissions")
}

// ============================================================
// MULTI-TENANT
// ============================================================

model Member {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  userId         String @map("user_id")
  roleId         String @map("role_id")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, userId])
  @@map("members")
}

model Organization {
  id                        String  @id @default(uuid())
  name                      String
  slug                      String  @unique
  domain                    String? @unique
  shouldAttachUsersByDomain Boolean @default(false) @map("should_attach_users_by_domain")
  avatarKey                 String? @map("avatar_key")
  standardAvatarKey         String? @map("standard_avatar_key")
  customizableAvatarKey     String? @map("customizable_avatar_key")

  isActive  Boolean   @default(true) @map("is_active")
  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  members                Member[]
  categories             Category[]
  banners                Banner[]
  socialHighlights       SocialHighlight[]
  tags                   Tag[]
  tagSearches            TagSearch[]
  faqs                   Faq[]
  faqItems               FaqItem[]
  category_role_accesses CategoryRoleAccess[]
  userHierarchies        UserHierarchy[]
  calendarEventTypes     CalendarEventType[]
  calendarEvents         CalendarEvent[]
  assets                 Asset[]
  materialTemplates      MaterialTemplate[]
  printPresets           PrintPreset[]
  printExports           PrintExport[]
  supplierDocument       SupplierDocument?
  notifications          Notification[]

  @@map("organizations")
}

model Asset {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  name           String
  fileKey        String @map("file_key")
  mimeType       String @map("mime_type")
  size           Int
  width          Int?
  height         Int?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization   Organization            @relation(fields: [organizationId], references: [id])
  templateAssets MaterialTemplateAsset[]

  @@index([organizationId, name])
  @@map("assets")
}

// ============================================================
// FORNECEDORES (DOCUMENTO PDF)
// ============================================================

model SupplierDocument {
  id             String @id @default(uuid())
  organizationId String @unique @map("organization_id")
  fileKey        String @map("file_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("supplier_documents")
}

// ============================================================
// CATEGORY (MENU HIERÁRQUICO)
// ============================================================

model Category {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")

  name     String
  slug     String
  slugPath String @map("slug_path")

  hasExternalLink Boolean @default(false) @map("has_external_link")
  externalLink    String? @map("external_link")

  isActive Boolean @default(true) @map("is_active")
  order    Int

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  organization Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  categoryRoleAccesses CategoryRoleAccess[]
  materials            Material[]

  @@unique([organizationId, slugPath])
  @@unique([organizationId, parentId, slug])
  @@unique([organizationId, parentId, order])
  @@index([organizationId])
  @@index([parentId])
  @@index([organizationId, parentId])
  @@map("categories")
}

// ============================================================
// CONTROLE DE ACESSO ÀS CATEGORIAS
// ============================================================

model CategoryRoleAccess {
  id             String @id @default(uuid())
  categoryId     String @map("category_id")
  roleId         String @map("role_id")
  organizationId String @map("organization_id")

  category     Category     @relation(fields: [categoryId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([categoryId, roleId, organizationId])
  @@index([roleId, organizationId])
  @@index([categoryId])
  @@map("category_role_accesses")
}

model Banner {
  id              String    @id @default(cuid())
  organizationId  String    @map("organization_id")
  mobileImageKey  String    @map("mobile_image_key")
  desktopImageKey String    @map("desktop_image_key")
  name            String
  link            String?
  order           Int
  isActive        Boolean   @default(true) @map("is_active")
  initialDate     DateTime? @map("initial_date")
  finishDate      DateTime? @map("finish_date")

  isDeleted    Boolean      @default(false) @map("is_deleted")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("banners")
}

model SocialHighlight {
  id              String    @id @default(cuid())
  organizationId  String    @map("organization_id")
  mobileImageKey  String    @map("mobile_image_key")
  desktopImageKey String    @map("desktop_image_key")
  name            String
  link            String?
  order           Int
  isActive        Boolean   @default(true) @map("is_active")
  initialDate     DateTime? @map("initial_date")
  finishDate      DateTime? @map("finish_date")

  isDeleted    Boolean      @default(false) @map("is_deleted")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("social_highlights")
}

// ============================================================
// CALENDAR
// ============================================================

model CalendarEventType {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  name           String
  slug           String
  color          String  @db.VarChar(7)
  description    String?
  order          Int     @default(0)
  isActive       Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  organization Organization    @relation(fields: [organizationId], references: [id])
  events       CalendarEvent[]

  @@index([organizationId])
  @@index([organizationId, order])
  @@map("calendar_event_types")
}

model CalendarEvent {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  eventTypeId     String   @map("event_type_id")
  title           String
  description     String
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  externalUrl     String?  @map("external_url")
  createdByUserId String   @map("created_by_user_id")
  isActive        Boolean  @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  organization Organization            @relation(fields: [organizationId], references: [id])
  eventType    CalendarEventType       @relation(fields: [eventTypeId], references: [id])
  createdBy    User                    @relation(fields: [createdByUserId], references: [id])
  materials    CalendarEventMaterial[]

  @@index([organizationId])
  @@index([organizationId, startDate, endDate])
  @@index([organizationId, eventTypeId])
  @@map("calendar_events")
}

model CalendarEventMaterial {
  eventId    String @map("event_id")
  materialId String @map("material_id")

  event    CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  material Material      @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([eventId, materialId])
  @@index([materialId])
  @@map("calendar_event_materials")
}

// ============================================================
// FAQ
// ============================================================

model Faq {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  name           String
  order          Int
  isActive       Boolean @default(true) @map("is_active")

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  items        FaqItem[]
  detail       FaqDetail?

  @@index([organizationId])
  @@map("faqs")
}

model FaqItem {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  faqId          String @map("faq_id")
  question       String
  answer         String
  order          Int

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  faq          Faq          @relation(fields: [faqId], references: [id])

  @@index([organizationId])
  @@index([faqId])
  @@map("faq_items")
}

model FaqDetail {
  id                       String  @id @default(uuid())
  faqId                    String  @unique @map("faq_id")
  imageKey                 String? @map("image_key")
  description              String?
  phonePrimary             String? @map("phone_primary")
  phonePrimaryLabel        String? @map("phone_primary_label")
  phonePrimaryIsWhatsapp   Boolean @default(false) @map("phone_primary_is_whatsapp")
  phoneSecondary           String? @map("phone_secondary")
  phoneSecondaryLabel      String? @map("phone_secondary_label")
  phoneSecondaryIsWhatsapp Boolean @default(false) @map("phone_secondary_is_whatsapp")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  faq Faq @relation(fields: [faqId], references: [id])

  @@map("faq_details")
}

// ATENÇÃO!
// Material está fora do padrão de soft delete. Corrigir para deletedAt e isDeleted, e ajustar queries para considerar ambos os campos.
model Material {
  id          String  @id @default(uuid())
  name        String
  description String?

  requiresAcceptance Boolean @default(false) @map("requires_acceptance")
  hasExternalLink    Boolean @default(false) @map("has_external_link")
  hasTextCopy        Boolean @default(false) @map("has_text_copy")
  onlyView           Boolean @default(false) @map("only_view")
  isCustomizable     Boolean @default(false) @map("is_customizable")

  externalLink String? @map("external_link")
  textCopy     String? @map("text_copy")

  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  deletedAt           DateTime?               @map("deleted_at")
  materialFiles       MaterialFile[]
  categoryId          String                  @map("category_id")
  category            Category                @relation(fields: [categoryId], references: [id])
  tags                Tag[]                   @relation("MaterialTag")
  materialAcceptances MaterialAcceptance[]
  materialViews       MaterialView[]
  materialDownloads   MaterialDownload[]
  materialTemplate    MaterialTemplate?
  calendarEvents      CalendarEventMaterial[]
  printExports        PrintExport[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("materials")
}

enum MaterialTemplateStatus {
  DRAFT
  PUBLISHED
}

enum PrintRenderingIntent {
  RELATIVE_COLORIMETRIC
  PERCEPTUAL
  SATURATION
  ABSOLUTE_COLORIMETRIC
}

enum PrintExportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

enum PrintPreflightStatus {
  PENDING
  READY
  FAILED
}

model MaterialTemplate {
  id                    String                 @id @default(uuid())
  organizationId        String                 @map("organization_id")
  materialId            String                 @unique @map("material_id")
  baseMaterialFileId    String?                @unique @map("base_material_file_id")
  printPresetId         String?                @map("print_preset_id")
  digitalExportMimeType String?                @map("digital_export_mime_type")
  allowedExportTypes    String[]               @default([]) @map("allowed_export_types")
  status                MaterialTemplateStatus @default(DRAFT)
  schemaVersion         Int                    @default(1) @map("schema_version")
  document              Json?
  legacyImport          Json?                  @map("legacy_import")
  revision              Int                    @default(0)
  publishedAt           DateTime?              @map("published_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  organization   Organization            @relation(fields: [organizationId], references: [id])
  material       Material                @relation(fields: [materialId], references: [id], onDelete: Cascade)
  baseFile       MaterialFile?           @relation(fields: [baseMaterialFileId], references: [id], onDelete: Restrict)
  printPreset    PrintPreset?            @relation(fields: [printPresetId], references: [id], onDelete: Restrict)
  assets         MaterialTemplateAsset[]
  printExports   PrintExport[]
  printPreflight PrintPreflight?

  @@index([organizationId, status])
  @@index([printPresetId])
  @@map("material_templates")
}

model MaterialTemplateAsset {
  templateId String @map("template_id")
  assetId    String @map("asset_id")

  template MaterialTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  asset    Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([templateId, assetId])
  @@index([assetId])
  @@map("material_template_assets")
}

model PrintColorProfile {
  id                        String   @id @default(uuid())
  name                      String   @unique
  storageKey                String   @unique @map("storage_key")
  checksum                  String   @unique
  outputConditionIdentifier String   @map("output_condition_identifier")
  description               String?
  isActive                  Boolean  @default(true) @map("is_active")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  presets PrintPreset[]

  @@map("print_color_profiles")
}

model PrintPreset {
  id                 String               @id @default(uuid())
  organizationId     String               @map("organization_id")
  colorProfileId     String               @map("color_profile_id")
  name               String
  trimWidthMm        Decimal              @map("trim_width_mm") @db.Decimal(10, 3)
  trimHeightMm       Decimal              @map("trim_height_mm") @db.Decimal(10, 3)
  bleedTopMm         Decimal              @default(0) @map("bleed_top_mm") @db.Decimal(10, 3)
  bleedRightMm       Decimal              @default(0) @map("bleed_right_mm") @db.Decimal(10, 3)
  bleedBottomMm      Decimal              @default(0) @map("bleed_bottom_mm") @db.Decimal(10, 3)
  bleedLeftMm        Decimal              @default(0) @map("bleed_left_mm") @db.Decimal(10, 3)
  safeMarginTopMm    Decimal              @default(0) @map("safe_margin_top_mm") @db.Decimal(10, 3)
  safeMarginRightMm  Decimal              @default(0) @map("safe_margin_right_mm") @db.Decimal(10, 3)
  safeMarginBottomMm Decimal              @default(0) @map("safe_margin_bottom_mm") @db.Decimal(10, 3)
  safeMarginLeftMm   Decimal              @default(0) @map("safe_margin_left_mm") @db.Decimal(10, 3)
  minimumDpi         Int                  @default(300) @map("minimum_dpi")
  includeCropMarks   Boolean              @default(true) @map("include_crop_marks")
  cropMarkOffsetMm   Decimal              @default(3) @map("crop_mark_offset_mm") @db.Decimal(10, 3)
  renderingIntent    PrintRenderingIntent @default(RELATIVE_COLORIMETRIC) @map("rendering_intent")
  isActive           Boolean              @default(true) @map("is_active")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  colorProfile PrintColorProfile  @relation(fields: [colorProfileId], references: [id], onDelete: Restrict)
  templates    MaterialTemplate[]

  @@unique([organizationId, name])
  @@index([colorProfileId])
  @@map("print_presets")
}

model PrintPreflight {
  id               String               @id @default(uuid())
  templateId       String               @unique @map("template_id")
  templateRevision Int                  @map("template_revision")
  presetUpdatedAt  DateTime             @map("preset_updated_at")
  status           PrintPreflightStatus @default(PENDING)
  issues           Json
  checkedAt        DateTime?            @map("checked_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  template MaterialTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("print_preflights")
}

model PrintExport {
  id               String            @id @default(uuid())
  organizationId   String            @map("organization_id")
  materialId       String            @map("material_id")
  templateId       String            @map("template_id")
  userId           String            @map("user_id")
  idempotencyKey   String            @map("idempotency_key")
  templateRevision Int               @map("template_revision")
  documentHash     String            @map("document_hash")
  presetSnapshot   Json              @map("preset_snapshot")
  status           PrintExportStatus @default(QUEUED)
  progress         Int               @default(0)
  errorCode        String?           @map("error_code")
  errorMessage     String?           @map("error_message")
  fileKey          String?           @map("file_key")
  checksum         String?
  size             Int?
  expiresAt        DateTime?         @map("expires_at")
  downloadedAt     DateTime?         @map("downloaded_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  material     Material         @relation(fields: [materialId], references: [id], onDelete: Cascade)
  template     MaterialTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId, idempotencyKey])
  @@index([status, expiresAt])
  @@index([materialId, userId, createdAt])
  @@map("print_exports")
}

model MaterialAcceptance {
  id         String   @id @default(uuid())
  materialId String   @map("material_id")
  userId     String   @map("user_id")
  accepted   Boolean  @default(true)
  acceptedAt DateTime @default(now()) @map("accepted_at")
  createdAt  DateTime @default(now()) @map("created_at")

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([materialId, userId])
  @@index([materialId])
  @@index([userId])
  @@map("material_acceptances")
}

model MaterialView {
  id         String   @id @default(uuid())
  materialId String   @map("material_id")
  viewedAt   DateTime @default(now()) @map("viewed_at")

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([viewedAt])
  @@map("material_views")
}

model MaterialDownload {
  id           String   @id @default(uuid())
  materialId   String   @map("material_id")
  userId       String   @map("user_id")
  downloadedAt DateTime @default(now()) @map("downloaded_at")

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([materialId])
  @@index([userId])
  @@index([downloadedAt])
  @@map("material_downloads")
}

model MaterialFile {
  id         String @id @default(uuid())
  materialId String @map("material_id")
  imageKey   String @map("image_key")
  mimeType   String @map("mime_type")
  size       Int    @map("size")
  width      Int?
  height     Int?

  material Material          @relation(fields: [materialId], references: [id])
  template MaterialTemplate?

  @@map("material_files")
}

model Tag {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  name           String

  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id])
  material     Material[]   @relation("MaterialTag")
  tagSearches  TagSearch[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("tags")
}

model TagSearch {
  id             String   @id @default(uuid())
  searchId       String   @map("search_id")
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  term           String
  search         String
  tagId          String?  @map("tag_id")
  tagName        String   @map("tag_name")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  tag          Tag?         @relation(fields: [tagId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId, searchId, tagName])
  @@index([organizationId, createdAt])
  @@index([organizationId, term])
  @@index([tagId])
  @@index([search])
  @@map("tag_searches")
}

// ============================================================
// LOG
// ============================================================

model Log {
  id        String   @id @default(uuid())
  level     LogLevel
  message   String   @map("message")
  context   Json?    @map("context")
  requestId String?  @map("request_id")
  path      String?  @map("path")
  method    String?  @map("method")
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("logs")
}

enum LogLevel {
  INFO
  WARNING
  ERROR
}

enum NotificationType {
  MATERIAL_CREATED
  MATERIAL_UPDATED
  CATEGORY_CREATED
}

model Notification {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  type           NotificationType
  title          String
  body           String
  href           String
  resourceType   String           @map("resource_type")
  resourceId     String           @map("resource_id")
  actorUserId    String?          @map("actor_user_id")
  dedupeKey      String           @unique @map("dedupe_key")
  readAt         DateTime?        @map("read_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, organizationId, createdAt(sort: Desc)])
  @@index([userId, organizationId, readAt])
  @@index([organizationId, resourceType, resourceId])
  @@map("notifications")
}

model SeedStatus {
  id         String   @id @default(cuid())
  executedAt DateTime @default(now()) @map("executed_at")

  @@map("seed_status")
}
