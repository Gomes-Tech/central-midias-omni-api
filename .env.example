# ==============================================================================
# Aplicacao HTTP
# Referencias: src/infrastructure/config/config.module.ts, src/main.ts,
# src/infrastructure/prisma/prisma.service.ts e prisma/schema.prisma
# ==============================================================================

# Ambiente aceito pela validacao: dev ou prod.
# Em prod, habilita as exigencias de SMTP/FRONTEND_URL e reduz logs/documentacao.
NODE_ENV=dev

# Porta HTTP da API. Padrao no codigo: 4000.
PORT=4000

# Conexao PostgreSQL consumida pelo Prisma.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/central_midias

# Segredo compartilhado validado no header x-api-key e no handshake WebSocket.
# Referencias: src/common/guards/auth.guard.ts e
# src/modules/notification/gateway/notification.gateway.ts
SERVER_AUTH_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Origins autorizadas em CORS HTTP e WebSocket, separadas por virgula e sem path.
# Em dev, a ausencia libera qualquer origin; em prod, a ausencia bloqueia origins.
# Referencias: src/main.ts e src/modules/notification/notification.constants.ts
# ALLOWED_ORIGINS=http://localhost:3000,https://app.exemplo.com.br

# URL publica do frontend, sem barra final. Usada nos links enviados por e-mail.
# Obrigatoria pela validacao quando NODE_ENV=prod.
# Referencias: src/common/utils/build-portal-material-link.ts,
# src/modules/token-password/use-cases/create-token-password.use-case.ts e
# src/modules/user/use-cases/create-user.use-case.ts
FRONTEND_URL=http://localhost:3000

# Validade, em minutos, do token de redefinicao de senha. Padrao: 15.
# Referencias: src/modules/token-password/repository/token-password.repository.ts
# e src/modules/token-password/use-cases/create-token-password.use-case.ts
TOKEN_PASSWORD_EXPIRES_MINUTES=15

# ==============================================================================
# Autenticacao JWT
# Referencias: src/infrastructure/jwt/jwt.module.ts,
# src/modules/auth/use-cases/sign-in.use-case.ts,
# src/modules/auth/use-cases/refresh-token.use-case.ts e
# src/modules/auth/use-cases/logout.use-case.ts
# ==============================================================================

# Segredos diferentes para access token e refresh token.
JWT_SECRET=troque-por-um-segredo-jwt-aleatorio
JWT_REFRESH_SECRET=troque-por-outro-segredo-jwt-aleatorio

# Duracoes no formato aceito pela biblioteca ms, por exemplo: 15m, 1h ou 7d.
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ==============================================================================
# E-mail SMTP
# Referencia: src/infrastructure/providers/mail/mail.module.ts
# Obrigatorio pela validacao quando NODE_ENV=prod; em dev, os envios reais sao
# normalmente substituidos por logs nos casos de uso.
# ==============================================================================

SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=usuario-smtp
SMTP_PASS=troque-pela-senha-smtp
SMTP_FROM=no-reply@exemplo.com

# true para conexao TLS implicita (normalmente porta 465); false para STARTTLS.
SMTP_SECURE=false

# ==============================================================================
# Redis / BullMQ
# Referencias: src/infrastructure/queue/queue.module.ts e
# src/infrastructure/redis/redis.module.ts
# ==============================================================================

# No Docker Compose estes dois valores sao sobrescritos para redis:6379.
REDIS_HOST=localhost
REDIS_PORT=6379

# Informe somente quando a instancia Redis exigir autenticacao.
# REDIS_PASSWORD=troque-pela-senha-do-redis

# ==============================================================================
# Storage
# Referencia de selecao: src/infrastructure/providers/storage/storage.module.ts
# Valores aceitos: supabase (padrao) ou s3. Preencha a secao do provider escolhido.
# ==============================================================================

STORAGE_PROVIDER=supabase

# --- Supabase Storage ---------------------------------------------------------
# Referencia: src/infrastructure/providers/storage/supabase.service.ts

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=troque-pela-chave-de-servico-do-supabase
SUPABASE_BUCKET=uploads

# Bucket publico para os assets do editor. Se omitido, usa SUPABASE_BUCKET.
# SUPABASE_ASSETS_BUCKET=editor-assets

# Validade das URLs assinadas, em segundos. Padrao: 300.
SUPABASE_SIGNED_URL_EXPIRES_SECONDS=300

# --- AWS S3 ------------------------------------------------------------------
# Referencia: src/infrastructure/providers/storage/s3-storage.service.ts
# Necessario somente quando STORAGE_PROVIDER=s3.

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=troque-pelo-access-key-id
AWS_SECRET_ACCESS_KEY=troque-pelo-secret-access-key

# Bucket privado dos arquivos gerais e bucket publico dos assets do editor.
S3_BUCKET=central-midias-uploads
S3_ASSETS_BUCKET=central-midias-editor-assets

# Validade das URLs pre-assinadas, em segundos. Padrao: 300.
S3_PRESIGNED_EXPIRES_SECONDS=300

# ==============================================================================
# Exportacao para impressao
# Referencias: src/modules/print/services/print-export.service.ts e
# src/infrastructure/config/config.module.ts
# ==============================================================================

# Feature flag. Somente o valor literal true libera a criacao de exportacoes.
PRINT_EXPORT_ENABLED=false
